# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- The app ---------------------------------------------------------------

# Address to listen on. The Docker image sets 0.0.0.0; natively the
# default, 127.0.0.1, keeps the app private to this machine.
# APP_HOST=127.0.0.1

# Port to listen on.
APP_PORT=8000

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# SQLite database for settings, history, feedback and feed events. The
# Docker image sets /data/chat_hacksman.db (a named volume in compose).
# CHAT_HACKSMAN_DB_PATH=./data/chat_hacksman.db

# Link shown in the UI footer.
# REPO_URL=https://github.com/romkey/pdxhackerspace-chat-hacksman

# Optional HTTP basic auth for everything except /health and /healthz. Set
# both to turn it on.
# BASIC_AUTH_USERNAME=hacksman
# BASIC_AUTH_PASSWORD=REPLACE_ME

# Optional Sentry error reporting.
# SENTRY_DSN=https://REPLACE_ME@o0.ingest.sentry.io/0

# --- Topics feed (buttons in the UI) ---------------------------------------

RAG_TOPICS_URL=https://members.pdxhackerspace.org/rag.json
# TOPICS_CACHE_TTL_SECONDS=300

# --- Qdrant (retrieval) ----------------------------------------------------
# Collections from the shared RAG pipeline. Each point has a dense and a
# sparse (BM25) vector; both are searched and the results fused. The sparse
# query is embedded by Qdrant itself (server-side BM25 inference).

QDRANT_URL=http://localhost:6333
# Use a key that can read only this bot's collections.
# QDRANT_API_KEY=REPLACE_ME

# Collections to search, comma-separated.
# RAG_COLLECTIONS=hs_member,hs_catalog

# Hits per collection from the fused search, and chunks given to the model.
# Every hit goes through the reranker, so fewer candidates answer faster
# (the default is 50); 20 per collection is plenty for most questions.
RAG_CANDIDATES=20
# RAG_TOP_N=8

# Vector names the ingester used; "none" for an unnamed dense vector, or
# for no sparse vector (dense-only search).
# RAG_DENSE_VECTOR=dense
# RAG_SPARSE_VECTOR=sparse
# RAG_SPARSE_MODEL=qdrant/bm25

# Lowest similarity to keep, in dense-only search only.
# RAG_MIN_SCORE=0.5

# Points with any other tier are never used. admin is refused.
# RAG_ALLOWED_TIERS=public,member

# How much authority (policy/sign 5 ... Slack 1) lifts a chunk whose
# relevance is close to another's; 0 is relevance alone.
# RAG_AUTHORITY_WEIGHT=0.1

# --- Conversation and answers ----------------------------------------------

# Earlier messages used to rewrite the question and sent to the model.
# CHAT_HISTORY_TURNS=6

# The answer when nothing relevant is found (the model isn't asked).
# NO_ANSWER_MESSAGE=I couldn't find that. Try the wiki, Slack, or the next open house.

# --- Embeddings for RAG queries --------------------------------------------
# Any OpenAI-compatible embeddings API (POST {EMBEDDING_URL}/embeddings):
# OpenAI, Hugging Face TEI, Infinity, vLLM, llama.cpp's llama-server...
# If it's unreachable, RAG is skipped. It must be the same model the
# collections were ingested with.

# Base URL, including /v1 (e.g. https://api.openai.com/v1).
EMBEDDING_URL=http://localhost:8080/v1

# Sent as "Authorization: Bearer ..."; leave unset for servers without auth.
# EMBEDDING_API_KEY=REPLACE_ME

EMBEDDING_MODEL=nomic-ai/modernbert-embed-base

# Tokens the model accepts; longer queries are cut to fit.
# EMBEDDING_CONTEXT_LENGTH=8192
# EMBEDDING_TIMEOUT_SECONDS=30

# Prefix ("prompt") put in front of every query before embedding. Leave it
# unset to use the model's own, for the models below (matched by name); set
# it for any other model that needs one. Use "none" for no prefix, \n for a
# newline; a space is added if the prefix doesn't end in one. It must match
# the query prefix the ingester was built for, and the ingester must embed
# documents with the model's document prefix.
#
#   Model                                      Query prefix / document prefix
#   nomic-ai/modernbert-embed-base (default)   "search_query: " / "search_document: "
#     768-dim (Matryoshka 256), 8192-token context
#   nomic-ai/nomic-embed-text-v1.5             "search_query: " / "search_document: "
#     768-dim, 8192-token context
#   intfloat/e5-large-v2                       "query: " / "passage: "
#     1024-dim, 512-token context (also intfloat/multilingual-e5-large)
#   mixedbread-ai/mxbai-embed-large-v1         "Represent this sentence for searching relevant passages: " / none
#     1024-dim, 512-token context
#   Qwen/Qwen3-Embedding-0.6B                  "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:" / none
#     1024-dim, 32768-token context (set EMBEDDING_CONTEXT_LENGTH to what you serve)
#   OpenAI text-embedding-3-small / -large     none / none
#     1536 / 3072-dim, 8191-token context
# EMBEDDING_QUERY_PREFIX="search_query: "

# --- Reranking (optional) --------------------------------------------------
# A second pass after the search: a cross-encoder reranker reads the query
# with each candidate chunk and scores how well the chunk answers it, then
# only the best RAG_TOP_N go to the model. Off unless RERANK_URL is set; if
# the reranker is unreachable, the search order is used.
#
# It needs a reranker model served by one of:
#   llama.cpp:  llama-server -m <reranker>.gguf --reranking --port 8012
#               RERANK_URL=http://localhost:8012/v1
#   vLLM:       vllm serve BAAI/bge-reranker-v2-m3
#               RERANK_URL=http://localhost:8000/v1
#   Hugging Face TEI (RERANK_API=tei):
#               docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference:cpu-1.9 \
#                 --model-id BAAI/bge-reranker-v2-m3
#               RERANK_URL=http://localhost:8080
#   Infinity:   RERANK_URL=<its base URL> (serves /rerank)
#
#   Model                                       Languages          Context  License
#   BAAI/bge-reranker-v2-m3 (default)           multilingual       8192     Apache-2.0
#   Alibaba-NLP/gte-reranker-modernbert-base    English            8192     Apache-2.0 (smaller, faster)
#   BAAI/bge-reranker-base / -large             English, Chinese   512      MIT
#   mixedbread-ai/mxbai-rerank-base-v1          English            512      Apache-2.0
#   jinaai/jina-reranker-v2-base-multilingual   multilingual       1024     CC-BY-NC-4.0 (non-commercial)

# Base URL; requests go to {RERANK_URL}/rerank.
# RERANK_URL=http://localhost:8012/v1

# Request format: jina (Jina and Cohere APIs, llama.cpp, vLLM, Infinity) or
# tei (Hugging Face text-embeddings-inference).
# RERANK_API=jina

# Sent as "Authorization: Bearer ..."; leave unset for servers without auth.
# RERANK_API_KEY=REPLACE_ME

# Model name; TEI ignores it (it serves one model).
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Drop chunks the reranker scores below this; unset keeps all of the top
# RAG_TOP_N. The scale depends on the server and model: TEI returns 0-1,
# llama.cpp can return raw scores (about -11 to 4 for bge-reranker-v2-m3 in
# testing). Look at a few rerank_score values in chat responses first. If
# none are left, the bot gives NO_ANSWER_MESSAGE.
# RERANK_MIN_SCORE=0.1

# Tokens per question + chunk; longer chunks are cut. The pipeline's chunks
# are 300-500 tokens, so 512 loses little and reranks much faster than the
# default 8192.
RERANK_CONTEXT_LENGTH=512
# RERANK_TIMEOUT_SECONDS=30

# --- Chat LLM --------------------------------------------------------------
# Any OpenAI-compatible chat completions API
# (POST {LLM_URL}/chat/completions): OpenAI, llama.cpp's llama-server, vLLM,
# LM Studio, LiteLLM... The UI can't change the server, only the model.

# Base URL, including /v1 (e.g. https://api.openai.com/v1,
# http://localhost:8080/v1 for llama-server).
LLM_URL=http://localhost:8080/v1

# Sent as "Authorization: Bearer ..."; leave unset for servers without auth.
# LLM_API_KEY=REPLACE_ME

# The model used unless one is picked in the UI. Unset: the first model the
# server lists at GET {LLM_URL}/models (fine for llama-server, which serves
# one).
# LLM_MODEL=gpt-4o-mini

# The bot's own prompt (changeable in the UI); the fixed answering rules
# always come first. Default: the member bot's instructions.
# DEFAULT_SYSTEM_PROMPT=You are Chat Hacksman, the PDX Hackerspace assistant for members.

# A JSON object merged into every chat request, for server-specific
# options; it can't set model, messages or stream, and the bot's own fields
# (temperature, max_tokens...) win. Reasoning ("thinking") models can spend
# the whole max_tokens thinking and answer nothing, so turn reasoning off:
#   Qwen3 and other templates with enable_thinking (llama.cpp, vLLM):
#     {"chat_template_kwargs": {"enable_thinking": false}}
#   gpt-oss and OpenAI reasoning models (can't fully turn off):
#     {"reasoning_effort": "low"}
# A server ignores fields it doesn't know, but a router may reject them.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Request resilience.
# LLM_TIMEOUT_SECONDS=180
# LLM_RETRY_ATTEMPTS=2
# LLM_RETRY_BACKOFF_SECONDS=0.5

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
