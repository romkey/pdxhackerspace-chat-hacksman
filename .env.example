# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- The app ---------------------------------------------------------------

# Address to listen on. The Docker image sets 0.0.0.0; natively the
# default, 127.0.0.1, keeps the app private to this machine.
# APP_HOST=127.0.0.1

# Port to listen on.
APP_PORT=8000

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# SQLite database for settings, history, feedback and feed events. The
# Docker image sets /data/chat_hacksman.db (a named volume in compose).
# CHAT_HACKSMAN_DB_PATH=./data/chat_hacksman.db

# Link shown in the UI footer.
# REPO_URL=https://github.com/romkey/pdxhackerspace-chat-hacksman

# Optional HTTP basic auth for everything except /health and /healthz. Set
# both to turn it on.
# BASIC_AUTH_USERNAME=hacksman
# BASIC_AUTH_PASSWORD=REPLACE_ME

# Optional Sentry error reporting.
# SENTRY_DSN=https://REPLACE_ME@o0.ingest.sentry.io/0

# --- Topics feed (buttons in the UI) ---------------------------------------

RAG_TOPICS_URL=https://members.pdxhackerspace.org/rag.json
# TOPICS_CACHE_TTL_SECONDS=300

# --- Qdrant (optional RAG) -------------------------------------------------

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=REPLACE_ME

# Collections to search: a comma-separated list, and/or one per variable.
# RAG_COLLECTIONS=members_docs,training_docs
# RAG_COLLECTION_1=members_docs
# RAG_COLLECTION_2=training_docs
# RAG_COLLECTION_3=wiki_docs
# RAG_COLLECTION_4=events
# RAG_COLLECTION_5=slack

# Chunks to use per collection, and the lowest similarity score to keep.
# RAG_TOP_K=4
# RAG_TOP_K_EVENTS=3
# RAG_TOP_K_SLACK=3
# RAG_TOP_K_CALIBRE=2
# RAG_MIN_SCORE=0.5

# --- Embeddings for RAG queries --------------------------------------------
# Any OpenAI-compatible embeddings API (POST {EMBEDDING_URL}/embeddings):
# OpenAI, Hugging Face TEI, Infinity, vLLM, llama.cpp's llama-server,
# Ollama's /v1 API... If it's unreachable, RAG is skipped. It must be the
# same model the collections were ingested with.

# Base URL, including /v1 (e.g. https://api.openai.com/v1,
# http://localhost:11434/v1 for Ollama).
EMBEDDING_URL=http://localhost:8080/v1

# Sent as "Authorization: Bearer ..."; leave unset for servers without auth.
# EMBEDDING_API_KEY=REPLACE_ME

EMBEDDING_MODEL=nomic-ai/modernbert-embed-base

# Tokens the model accepts; longer queries are cut to fit.
# EMBEDDING_CONTEXT_LENGTH=8192
# EMBEDDING_TIMEOUT_SECONDS=30

# Prefix ("prompt") put in front of every query before embedding. Leave it
# unset to use the model's own, for the models below (matched by name); set
# it for any other model that needs one. Use "none" for no prefix, \n for a
# newline; a space is added if the prefix doesn't end in one. It must match
# the query prefix the ingester was built for, and the ingester must embed
# documents with the model's document prefix.
#
#   Model                                      Query prefix / document prefix
#   nomic-ai/modernbert-embed-base (default)   "search_query: " / "search_document: "
#     768-dim (Matryoshka 256), 8192-token context
#   nomic-ai/nomic-embed-text-v1.5             "search_query: " / "search_document: "
#     768-dim, 8192-token context
#   intfloat/e5-large-v2                       "query: " / "passage: "
#     1024-dim, 512-token context (also intfloat/multilingual-e5-large)
#   mixedbread-ai/mxbai-embed-large-v1         "Represent this sentence for searching relevant passages: " / none
#     1024-dim, 512-token context
#   Qwen/Qwen3-Embedding-0.6B                  "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:" / none
#     1024-dim, 32768-token context (set EMBEDDING_CONTEXT_LENGTH to what you serve)
#   OpenAI text-embedding-3-small / -large     none / none
#     1536 / 3072-dim, 8191-token context
# EMBEDDING_QUERY_PREFIX="search_query: "

# --- Chat model defaults (changeable in the UI) ----------------------------

# ollama or llama_cpp.
DEFAULT_PROVIDER=ollama
DEFAULT_LLM_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:latest
# DEFAULT_SYSTEM_PROMPT=You are Chat Hacksman, an expert assistant for hackerspace members.

# Sent as "Authorization: Bearer ..." to Ollama, for hosted or proxied Ollama.
# OLLAMA_API_KEY=REPLACE_ME

# Request resilience for both Ollama and llama.cpp.
# LLM_TIMEOUT_SECONDS=180
# LLM_RETRY_ATTEMPTS=2
# LLM_RETRY_BACKOFF_SECONDS=0.5

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
